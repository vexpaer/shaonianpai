<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:orientation="vertical">

    <!-- Authentic compact row: left 16dp, top/bottom 4dp, 32dp icon, 18sp title, 22dp star -->
    <LinearLayout
        android:id="@+id/kpParent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/ImageViewFileType"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_word" />

        <TextView
            android:id="@+id/TextTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="资源标题"
            android:textColor="@color/textPrimary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:text="443 KB"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/ImageViewFav"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_star_light" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/separateLine" />
</LinearLayout>
