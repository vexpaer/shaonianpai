<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/MainDesktopView2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFE8E8E8">

        <!-- Full-bleed stretched desk canvas in BOTH landscape and portrait -->
        <FrameLayout
            android:id="@+id/deskCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/ivDesktopBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/background_desktop" />

            <!-- 7 authentic desk objects mapped via relative coordinates [0..1] -->
            <FrameLayout
                android:id="@+id/MainDesktopView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- Authentic top-left blue 3-bar hamburger menu button with transparent background (02_主桌面.png) -->
        <ImageView
            android:id="@+id/imageButtonDrawer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="打开左侧菜单"
            android:focusable="true"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_menu_blue_desk" />

        <TextView
            android:id="@+id/textViewIMState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Bottom-right version ONLY (dark translucent matching 02_主桌面.png) -->
        <TextView
            android:id="@+id/textViewVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="8dp"
            android:text="v0.1.7"
            android:textColor="#AA000000"
            android:textSize="12.5sp" />
    </RelativeLayout>

    <!-- Authentic 250dp left drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        app:headerLayout="@layout/drawer_header"
        app:itemIconTint="#212121"
        app:itemTextColor="#212121"
        app:menu="@menu/menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
