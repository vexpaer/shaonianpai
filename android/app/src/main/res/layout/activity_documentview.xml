<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pdfDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFE1E1E1">

    <!-- Main Foxit Reader Frame (rd_main_frame.xml faithful structure) -->
    <RelativeLayout
        android:id="@+id/pdfMainRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Interactive PDF + Vector Annotation Canvas -->
        <com.shaonianpai.tablet.pdf.PdfAnnotCanvasView
            android:id="@+id/pdfCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/pdfBottomBar"
            android:layout_below="@id/pdfTopBarContainer" />

        <!-- Floating Previous / Next Page Arrows (from original rd_main_frame.xml) -->
        <ImageView
            android:id="@+id/btnFloatPrev"
            android:layout_width="56dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="6dp"
            android:alpha="0.72"
            android:contentDescription="上一页"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/fx_page_prev" />

        <ImageView
            android:id="@+id/btnFloatNext"
            android:layout_width="56dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="6dp"
            android:alpha="0.72"
            android:contentDescription="下一页"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:src="@drawable/fx_page_next" />

        <!-- Top Bar Container (#179CD8 Foxit Sky Blue) -->
        <LinearLayout
            android:id="@+id/pdfTopBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:elevation="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="#FF179CD8"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <ImageButton
                    android:id="@+id/btnPdfBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="返回"
                    android:src="@drawable/ic_arrow_back_white_24dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPdfTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="PDF 阅读与批注"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPdfSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="福昕风格批注引擎 · 0 条批注"
                        android:textColor="#DDF0FAFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnBookmarkToggle"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="书签"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/fx_bookmark" />

                <ImageButton
                    android:id="@+id/btnSearchToggle"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="全文搜索"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#FFFFFFFF" />

                <TextView
                    android:id="@+id/btnExportPdf"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="导出"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnOpenExternal"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="外部"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar1"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="10000"
                android:progress="0"
                android:progressDrawable="@drawable/green_progressbar" />

            <!-- Expandable Full-Text Search Bar -->
            <LinearLayout
                android:id="@+id/pdfSearchBar"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="#FFFFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etSearchQuery"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="#FFF2F4F7"
                    android:hint="搜索全文关键词..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingHorizontal="10dp"
                    android:singleLine="true"
                    android:textColor="#FF212121"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnSearchRun"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="#FF179CD8"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="查找"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSearchCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:text="0/0"
                    android:textColor="#FF666666"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnSearchPrev"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="▲"
                    android:textColor="#FF179CD8"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnSearchNext"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="▼"
                    android:textColor="#FF179CD8"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnSearchClose"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#FF666666"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Page Badge Pill (clickable to jump page) -->
        <TextView
            android:id="@+id/tvPageBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/pdfTopBarContainer"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_fx_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="第 1 / 1 页"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <!-- Active Tool Prompt Pill (read_tool_set_bar_ly) -->
        <LinearLayout
            android:id="@+id/pdfToolPromptBar"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_above="@id/pdfBottomBar"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_fx_pill"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvActiveToolHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="高亮：拖动选中文字或区域"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/btnContinuousToggle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="10dp"
                android:contentDescription="连续标注"
                android:src="@drawable/fx_continuous_on" />

            <TextView
                android:id="@+id/tvContinuousLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="连续"
                android:textColor="#FF81D4FA"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- More Tools 3-Group Popup Sheet (mt_moretools.xml faithful recreation) -->
        <ScrollView
            android:id="@+id/pdfMoreToolsSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/pdfBottomBar"
            android:background="@drawable/bg_fx_sheet"
            android:elevation="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="全部批注工具"
                        android:textColor="#FF179CD8"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnCloseMoreTools"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:paddingHorizontal="8dp"
                        android:text="收起 ✕"
                        android:textColor="#FF757575"
                        android:textSize="12sp" />
                </RelativeLayout>

                <!-- Group 1: 文字标记 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="文字标记"
                    android:textColor="#FF424242"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/llSheetMarkup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#FFE8E8E8" />

                <!-- Group 2: 绘画 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="绘画"
                    android:textColor="#FF424242"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/llSheetDrawing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#FFE8E8E8" />

                <!-- Group 3: 注释与其他 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="注释与其他"
                    android:textColor="#FF424242"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/llSheetOthers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </ScrollView>

        <!-- Property Bar Popup Sheet (pb_rl_propertybar + pb_color + pb_linewidth + pb_opacity) -->
        <LinearLayout
            android:id="@+id/pdfPropertySheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/pdfBottomBar"
            android:background="@drawable/bg_fx_sheet"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="颜色"
                    android:textColor="#FF757575"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnCloseProperty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:paddingHorizontal="6dp"
                    android:text="完成 ✓"
                    android:textColor="#FF179CD8"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/llColorPalette"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#FFE8E8E8" />

            <!-- Line Width (pb_linewidth.xml) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="宽度"
                android:textColor="#FF757575"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/vStrokePreviewDot"
                    android:layout_width="18dp"
                    android:layout_height="18dp" />

                <TextView
                    android:id="@+id/tvStrokeWidthVal"
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="4px"
                    android:textColor="#FF424242"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sbLineWidth"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="11"
                    android:progress="3" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#FFE8E8E8" />

            <!-- Opacity (pb_opacity.xml: 25%, 50%, 75%, 100%) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="透明"
                android:textColor="#FF757575"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/llOpacityOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- View Settings Popup Sheet (ml_setbar_tablet.xml faithful recreation) -->
        <LinearLayout
            android:id="@+id/pdfViewSettingsSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/pdfBottomBar"
            android:background="@drawable/bg_fx_sheet"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="阅读视图与护眼设置"
                    android:textColor="#FF179CD8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCloseViewSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:paddingHorizontal="8dp"
                    android:text="关闭 ✕"
                    android:textColor="#FF757575"
                    android:textSize="12sp" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:id="@+id/btnViewNightMode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:id="@+id/ivViewNightIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/fx_daynight_day" />

                    <TextView
                        android:id="@+id/tvViewNightLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="日间模式"
                        android:textColor="#FF424242"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnViewLockScreen"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/fx_lockscreen" />

                    <TextView
                        android:id="@+id/tvViewLockLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="自动旋转"
                        android:textColor="#FF424242"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnViewResetZoom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/fx_thumbnail" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="还原缩放"
                        android:textColor="#FF424242"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Brightness slider (ml_tablet_sb_light) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/fx_light_small" />

                <SeekBar
                    android:id="@+id/sbBrightness"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="80" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/fx_light_big" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Bar Container (Reading Mode + Annotation Quick Mode) -->
        <LinearLayout
            android:id="@+id/pdfBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#FFFAFAFA"
            android:elevation="6dp"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FFC9C9C9" />

            <!-- Mode 1: Foxit Main Reading Bottom Bar (列表 / 批注 / 视图 / 缩略图) -->
            <LinearLayout
                android:id="@+id/pdfMainBottomBar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnBarPanel"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/fx_bar_panel" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="列表"
                        android:textColor="#FF424242"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnBarEdit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/fx_bar_edit" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="批注"
                        android:textColor="#FF179CD8"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnBarSetting"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/fx_bar_setting" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="视图"
                        android:textColor="#FF424242"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnBarThumbnails"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/fx_thumbnail" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="缩略图"
                        android:textColor="#FF424242"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mode 2: Foxit Annotation Quick Bar (Horizontally scrollable for tablet & portrait phone) -->
            <HorizontalScrollView
                android:id="@+id/pdfAnnotBottomBar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/llAnnotQuickStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp" />
            </HorizontalScrollView>
        </LinearLayout>
    </RelativeLayout>

    <!-- Left Side Panel Drawer (panel_annot_topbar + panel_annot_content + Outline + Bookmarks) -->
    <LinearLayout
        android:id="@+id/pdfSidePanel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFFFF"
        android:orientation="vertical">

        <!-- Sky-blue Topbar matching panel_annot_topbar.xml -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#FF179CD8"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/tvSidePanelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="批注"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSidePanelClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="6dp"
                android:text="清空"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
        </RelativeLayout>

        <!-- 3-Tab Switcher: 批注 | 目录 | 书签 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#FFF5F7FA"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabSideAnnot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="批注"
                android:textColor="#FF179CD8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabSideOutline"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="目录"
                android:textColor="#FF666666"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tabSideBookmark"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="书签"
                android:textColor="#FF666666"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFE1E1E1" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/lvSidePanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="#FFE8E8E8"
                android:dividerHeight="1dp" />

            <TextView
                android:id="@+id/tvSidePanelEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="24dp"
                android:text="暂无批注，点击底部「批注」开始标记"
                android:textColor="#FF9A9A9A"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
