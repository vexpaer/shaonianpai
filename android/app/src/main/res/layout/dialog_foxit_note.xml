<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFFFF"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvNoteDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#179CD8"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="便签批注"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etNoteContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFBD9"
        android:gravity="top|start"
        android:hint="请输入批注内容、重点笔记或疑问..."
        android:inputType="textMultiLine"
        android:minLines="5"
        android:padding="16dp"
        android:textColor="#FF333333"
        android:textColorHint="#FF9E9E9E"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/llRepliesSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFAFAFA"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="回复记录"
            android:textColor="#FF666666"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/llRepliesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etReplyInput"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="#FFFFFFFF"
                android:hint="添加一条回复..."
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnAddReply"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#179CD8"
                android:minWidth="60dp"
                android:text="回复"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
