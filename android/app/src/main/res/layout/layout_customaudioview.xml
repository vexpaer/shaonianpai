<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/LinearLayout1"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="@android:color/transparent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="4dp"
    android:paddingRight="10dp">

    <ImageButton
        android:id="@+id/ImageButtonPlay"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="播放"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_audio_play_lightbar" />

    <ImageButton
        android:id="@+id/ImageButtonPause"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="暂停"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_audio_pause_lightbar"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvAudioTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="00:00 / 00:03"
        android:textColor="#FF424242"
        android:textSize="13sp" />

    <SeekBar
        android:id="@+id/SeekBarPosition"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:max="100" />
</LinearLayout>
