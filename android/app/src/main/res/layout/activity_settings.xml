<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF5F7FA"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/primaryColor"
        android:elevation="4dp"
        android:theme="@style/ToolbarTheme"
        app:title="设置"
        app:titleTextColor="#FFFFFF" />

    <!-- Responsive 1-Level (Headers) + 2-Level (Detail) Master-Detail Container -->
    <LinearLayout
        android:id="@+id/settingsSplitRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Level 1: Category Headers List -->
        <ScrollView
            android:id="@+id/svLevel1Headers"
            android:layout_width="296dp"
            android:layout_height="match_parent"
            android:background="#FFFFFFFF">

            <LinearLayout
                android:id="@+id/llLevel1Headers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="6dp" />
        </ScrollView>

        <View
            android:id="@+id/vSettingsDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#FFE0E0E0" />

        <!-- Level 2: Detail Settings Pane -->
        <ScrollView
            android:id="@+id/svLevel2Detail"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#FFF7F9FC">

            <LinearLayout
                android:id="@+id/llLevel2Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp" />
        </ScrollView>
    </LinearLayout>
</LinearLayout>
