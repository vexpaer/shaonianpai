<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/RelativeLayout1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFEAEAEA">

    <!-- Stretched original background_main (colorful polygon cloud + bottom-right 睿易 RUIYI logo) -->
    <ImageView
        android:id="@+id/ivLoginBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/background_main" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/imageViewVoice"
            android:layout_width="126dp"
            android:layout_height="126dp"
            android:layout_marginBottom="6dp"
            android:elevation="2dp"
            android:scaleType="centerCrop"
            android:src="@drawable/no_pic" />

        <TextView
            android:id="@+id/textViewRealName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:shadowColor="#FF000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="373601"
            android:textAppearance="?android:textAppearanceMedium"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextPassword"
            android:layout_width="270dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_login_underline"
            android:hint="请输入密码"
            android:inputType="textPassword"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:singleLine="true"
            android:text="123456"
            android:textColor="#FF212121"
            android:textColorHint="#FF555555"
            android:textSize="15sp" />

        <Button
            android:id="@+id/buttonLogin"
            android:layout_width="148dp"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_login_btn"
            android:text="登录"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/textViewNewVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="本地与离线演示服务已就绪，点击登录进入桌面"
            android:textColor="#FF616161"
            android:textSize="12.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/textViewVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:text="v0.1.7"
        android:textColor="#FF666666"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/textViewSwitchAccount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="10dp"
        android:paddingStart="4dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="6dp"
        android:text="切换账号"
        android:textColor="#FF1976D2"
        android:textSize="14.5sp" />
</RelativeLayout>
