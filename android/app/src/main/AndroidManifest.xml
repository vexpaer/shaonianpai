<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ShaonianpaiApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="少年派"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".ui.DesktopActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="true"
            android:label="少年派"
            android:screenOrientation="fullUser"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:label="登录"
            android:screenOrientation="fullUser"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".ui.SelfLearnActivity"
            android:exported="true"
            android:label="自主学习"
            android:screenOrientation="fullUser"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".ui.TaskDetailActivity"
            android:exported="true"
            android:label="任务详情"
            android:screenOrientation="fullUser"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".ui.DocumentViewActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="文档阅读"
            android:screenOrientation="fullUser"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".ui.VideoPlayerActivity"
            android:configChanges="orientation|screenSize"
            android:exported="true"
            android:label="视频播放"
            android:screenOrientation="fullUser"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".ui.ResourceLibraryActivity"
            android:exported="true"
            android:label="我的资源库"
            android:screenOrientation="fullUser"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".ui.QuestionBookActivity"
            android:exported="true"
            android:label="试题本"
            android:screenOrientation="fullUser"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".ui.ScheduleActivity"
            android:exported="true"
            android:label="日历"
            android:screenOrientation="fullUser"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".ui.BookDetailActivity"
            android:exported="true"
            android:label="电子教材"
            android:screenOrientation="fullUser"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true"
            android:label="设置"
            android:screenOrientation="fullUser"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".ui.FingerDrawActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="草稿本"
            android:screenOrientation="fullUser"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".ui.PhotoCaptureProxyActivity"
            android:exported="false"
            android:label="拍照收藏"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.AppCompat.Light.Dialog" />

        <activity
            android:name=".ui.AppsLauncherActivity"
            android:exported="true"
            android:label="软件与应用入口"
            android:screenOrientation="fullUser"
            android:theme="@style/AppTheme.NoActionBar" />

    </application>
</manifest>
